# Copy this file to .env in the project ROOT. Never upload .env to GitHub.
MONGODB_URI=mongodb://127.0.0.1:27017/fantasy_xi_v2
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-before-starting
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_EMAILS=your-real-admin-email@example.com
# Set TRUST_PROXY=1 only behind one trusted reverse proxy, e.g. Render.
# TRUST_PROXY=1
# Optional, only for one-time npm run admin:create:
# ADMIN_BOOTSTRAP_EMAIL=your-real-admin-email@example.com
# ADMIN_BOOTSTRAP_PASSWORD=your-unique-admin-password
# Split frontend/backend deployment only; set this before npm run build:
# VITE_API_URL=https://your-backend.onrender.com
